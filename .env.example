# Copy to .env and fill in:  cp .env.example .env
# .env is gitignored and will never be committed.

# Ethereum mainnet RPC URL (Alchemy / Infura free tier is fine)
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# Etherscan API key, used to verify the source code after deployment (https://etherscan.io/myapikey)
ETHERSCAN_API_KEY=

# Contract admin (can change the destination). Strongly recommended: a hardware wallet or Safe multisig.
OWNER=0x

# Destination: all ETH / ERC20 is forwarded here
DESTINATION=0x

# Name you gave the deployer key with `cast wallet import`
KEYSTORE_ACCOUNT=deployer
